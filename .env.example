# ═══════════════════════════════════════════════════════════════
# AI Council OS — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Authentication ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password
JWT_SECRET=generate-a-random-32-char-secret-here

# ── LLM Provider (Required) ────────────────────────────────────
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Database ────────────────────────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./data/council_os.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://council_user:council_pass@localhost:5432/council_os

# ── YouTube Integration (Optional) ─────────────────────────────
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
# YOUTUBE_CHANNEL_ID=your-channel-id

# ── Reddit Integration (Optional) ──────────────────────────────
# REDDIT_CLIENT_ID=your-reddit-app-client-id
# REDDIT_CLIENT_SECRET=your-reddit-app-client-secret
# REDDIT_USERNAME=your-reddit-username
# REDDIT_PASSWORD=your-reddit-password

# ── Telegram Bot (Optional) ─────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ── Instagram / Meta (Phase 2) ──────────────────────────────────
# Get from: https://developers.facebook.com/tools/explorer/
# Requires: instagram_basic, instagram_manage_comments permissions
# INSTAGRAM_ACCESS_TOKEN=your-long-lived-token-here
# INSTAGRAM_BUSINESS_ID=your-instagram-business-account-id
# INSTAGRAM_USERNAME=your-instagram-handle
# META_ACCESS_TOKEN=same-token-works-for-facebook-too
# FACEBOOK_PAGE_ID=your-facebook-page-numeric-id

# ── LinkedIn (Phase 2) ──────────────────────────────────────────
# OAuth token from https://www.linkedin.com/developers/
# Requires: w_member_social permission
# LINKEDIN_ACCESS_TOKEN=your-linkedin-oauth-token
# LINKEDIN_PERSON_ID=urn:li:person:your-id      (personal posting)
# LINKEDIN_ORGANIZATION_ID=urn:li:organization:id (company page posting)

# ── Twitter / X (Phase 2) ───────────────────────────────────────
# From https://developer.twitter.com/en/portal/dashboard
# Requires: Read and Write app permissions
# TWITTER_API_KEY=your-api-key
# TWITTER_API_SECRET=your-api-secret
# TWITTER_ACCESS_TOKEN=your-access-token
# TWITTER_ACCESS_SECRET=your-access-secret
# TWITTER_BEARER_TOKEN=your-bearer-token
