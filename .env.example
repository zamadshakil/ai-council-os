# ═══════════════════════════════════════════════════════════════
# AI Council OS — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Authentication ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password
JWT_SECRET=generate-a-random-32-char-secret-here

# ── LLM Provider (Required) ────────────────────────────────────
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Database ────────────────────────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./data/council_os.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://council_user:council_pass@localhost:5432/council_os

# ── YouTube Integration (Optional) ─────────────────────────────
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
# YOUTUBE_CHANNEL_ID=your-channel-id

# ── Reddit Integration (Optional) ──────────────────────────────
# REDDIT_CLIENT_ID=your-reddit-app-client-id
# REDDIT_CLIENT_SECRET=your-reddit-app-client-secret
# REDDIT_USERNAME=your-reddit-username
# REDDIT_PASSWORD=your-reddit-password

# ── Telegram Bot (Optional) ─────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ── Google Sheets Logging (Optional) ────────────────────────────
# GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google-sheets-creds.json
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
