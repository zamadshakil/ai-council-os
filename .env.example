# Copy to .env, fill every required blank, and never commit the result.

# Public HTTPS host. Replace SERVER_IP with the VPS IPv4 address.
PUBLIC_HOST=SERVER_IP.sslip.io
ENVIRONMENT=production
LOG_LEVEL=INFO
BACKEND_IMAGE=ai-council-backend:20260818-1
DASHBOARD_IMAGE=ai-council-dashboard:20260818-1

# PostgreSQL
POSTGRES_USER=council_os
# Use a long URL-safe value (letters, digits, hyphen, underscore) because this
# value is interpolated into DATABASE_URL by Compose.
POSTGRES_PASSWORD=
POSTGRES_DB=council_os
BACKUP_RETENTION_DAYS=7

# Single administrator and internal service authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ROTATE_ADMIN_PASSWORD_ON_STARTUP=1
INTERNAL_SERVICE_TOKEN=
# Generate with Python cryptography.Fernet.generate_key(); never expose this
# value to the browser or store it in the repository.
INTEGRATION_ENCRYPTION_KEY=

# Required model gateway. Use a newly rotated key.
OPENROUTER_API_KEY=

# Telegram control and approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# YouTube read/write integration
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_OAUTH_TOKEN=/app/credentials/youtube_token.json
YOUTUBE_WEBHOOK_SECRET=
YT_MAX_REPLIES_PER_RUN=50
YT_DESC_BATCH_SIZE=20

# Reddit lead discovery. Publishing remains manual.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AI Council OS Lead Prospector

# Approved content destinations (optional; still human approval-gated)
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
LINKEDIN_ORGANIZATION_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
DISCORD_WEBHOOK_URL=

# Optional Blender Manager cloud GPU control. Prefer the encrypted portal.
RUNPOD_API_KEY=
# A different random value used only between Council OS and the pod-side
# allowlisted Blender agent. Never reuse the RunPod API key.
BLENDER_AGENT_TOKEN=
BLENDER_AGENT_PORT=8001
BLENDER_WORKSPACE_ROOT=/workspace
