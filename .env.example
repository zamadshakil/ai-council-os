# ============================================
# AI Council OS — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
# NEVER commit the .env file to git.

# --- OpenRouter (single key for all LLMs) ---
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Database ---
DATABASE_URL=sqlite:///./council.db

# --- YouTube API ---
# Requires a Google Cloud project with YouTube Data API v3 enabled.
# For read-only (fetching comments): API key is sufficient.
# For write (posting replies, updating descriptions): OAuth2 is required.
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# --- Reddit API ---
# Create an app at https://www.reddit.com/prefs/apps
# Type: "script" for personal use, "web app" for production
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AICouncilOS Prospector/1.0
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_private_channel_id

# --- Google Sheets ---
# Service account credentials JSON file path
GOOGLE_SHEETS_CREDENTIALS=./credentials/sheets_service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# --- Social Platform APIs (for Multi-Platform Content Engine) ---
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=ai-council-os
